{
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno check src/main.tsx",
    "test": "deno test --allow-read src",
    "dev": "deno run -A npm:vite@7.3.2 --host 127.0.0.1",
    "build": "deno run -A npm:vite@7.3.2 build"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@codemirror/lang-json": "npm:@codemirror/lang-json@6.0.2",
    "@codemirror/lang-python": "npm:@codemirror/lang-python@6.2.1",
    "@codemirror/view": "npm:@codemirror/view@6.38.8",
    "@lezer/common": "npm:@lezer/common@1.5.2",
    "@lezer/python": "npm:@lezer/python@1.1.18",
    "@tanstack/react-query": "npm:@tanstack/react-query@5.99.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@4.2.2",
    "@types/react": "npm:@types/react@19.2.14",
    "@types/react-dom": "npm:@types/react-dom@19.2.3",
    "@uiw/react-codemirror": "npm:@uiw/react-codemirror@4.25.9",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@5.2.0",
    "@xyflow/react": "npm:@xyflow/react@12.10.2",
    "lucide-react": "npm:lucide-react@1.17.0",
    "react": "npm:react@19.2.5",
    "react/jsx-runtime": "npm:react@19.2.5/jsx-runtime",
    "react-dom/client": "npm:react-dom@19.2.5/client",
    "react-json-view-lite": "npm:react-json-view-lite@2.5.0",
    "tailwindcss": "npm:tailwindcss@4.2.2",
    "vite": "npm:vite@7.3.2"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["DOM", "DOM.Iterable", "ES2022", "deno.ns"],
    "strict": true,
    "types": [
      "npm:vite/client",
      "npm:@types/react",
      "npm:@types/react-dom"
    ]
  }
}
