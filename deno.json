{
  "tasks": {
    "setup": "deno run --allow-read --allow-write --allow-run setup.ts",
    "start": "deno run --allow-read --allow-write --allow-net --allow-run start.ts",
    "beta": "deno run --allow-read --allow-write --allow-net --allow-run --allow-env beta_launcher.ts",
    "beta:check": "deno check beta_launcher.ts main.ts",
    "beta:compile": "deno compile --allow-read --allow-write --allow-net --allow-run --allow-env --include VERSION --include pyproject.toml --include requirements-alpha.txt --include runner.py --include python_document_loader.py --include nodebook --include app/ui/dist --output dist/nodebook beta_launcher.ts",
    "release:build": "deno run --allow-read --allow-write --allow-run --allow-env release.ts build",
    "release:site": "deno run --allow-read --allow-write --allow-env release.ts site",
    "release:deploy:assets": "deno run --allow-read --allow-run --allow-env release.ts deploy-assets",
    "release:deploy:site": "deno run --allow-read --allow-run --allow-env release.ts deploy-site",
    "release:deploy": "deno run --allow-read --allow-run --allow-env release.ts deploy",
    "release": "deno run --allow-read --allow-write --allow-run --allow-env release.ts release",
    "dev": "deno run --watch --allow-read --allow-write --allow-net --allow-run main.ts",
    "cli": "deno run --allow-read --allow-run cli.ts",
    "ui:check": "cd app/ui && deno task check",
    "ui:dev": "cd app/ui && deno task dev",
    "ui:build": "cd app/ui && deno task build",
    "ui:preview": "cd app/ui && deno task preview"
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.12.9",
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli/parse-args": "jsr:@std/cli@1/parse-args"
  }
}
